---
import styles from "./submissions.module.css";
import Layout from "../../../layouts/layout.astro";
import AdminNavBar from "../../../components/adminnavbar.astro";
---

<Layout>
  <AdminNavBar />

  <main class={styles.page}>
    <div class={styles.panel}>
      <section class={styles.section} aria-labelledby="unreviewed-heading">
        <div class={styles.sectionHeading}>
          <h2 id="unreviewed-heading">
            Unreviewed Submissions (<span class={styles.count} data-count="unreviewed">0</span>)
          </h2>
        </div>
        <div class={styles.submissionList} data-list="unreviewed">
          <p class={styles.message}>Loading Submissions...</p>
        </div>
      </section>

      <section class={styles.section} aria-labelledby="reviewed-heading">
        <div class={styles.sectionHeading}>
          <h2 id="reviewed-heading">
            Reviewed Submissions (<span class={styles.count} data-count="reviewed">0</span>)
          </h2>
        </div>
        <div class={styles.submissionList} data-list="reviewed">
          <p class={styles.message}>Loading Submissions...</p>
        </div>
      </section>

      <p class={`${styles.message} ${styles.error}`} data-error hidden>
        Error - Try Again
      </p>
    </div>
  </main>

  <template id="submission-template">
    <article class={styles.submissionCard}>
      <div class={styles.cardContent}>
        <p class={styles.submissionTitle} data-title></p>
        <p class={styles.submissionMeta} data-meta></p>
        <p class={styles.status} data-status hidden></p>
      </div>
      <a class={styles.viewLink} data-view-link
        >View Submission <span aria-hidden="true">&rarr;</span></a
      >
    </article>
  </template>
</Layout>

<script>
  type Submission = {
    id: number;
    schoolName: string;
    countyName: string;
    submittedBy: string;
    submissionStatus: "pending" | "approved" | "rejected";
  };

  const template = document.querySelector<HTMLTemplateElement>(
    "#submission-template",
  );
  const errorMessage = document.querySelector<HTMLElement>("[data-error]");

  const createCard = (submission: Submission, reviewed: boolean) => {
    if (!template) return null;

    const card = template.content.cloneNode(true) as DocumentFragment;
    const title = card.querySelector<HTMLElement>("[data-title]");
    const meta = card.querySelector<HTMLElement>("[data-meta]");
    const status = card.querySelector<HTMLElement>("[data-status]");
    const viewLink = card.querySelector<HTMLAnchorElement>("[data-view-link]");

    if (title) {
      title.textContent = `${submission.schoolName} (${submission.countyName})`;
    }
    if (meta) {
      meta.textContent = `Submitted by ${submission.submittedBy}`;
    }
    if (status && reviewed) {
      status.hidden = false;
      status.dataset.status = submission.submissionStatus;
      status.textContent =
        submission.submissionStatus === "approved" ? "Accepted" : "Rejected";
    }
    if (viewLink) {
      viewLink.href = `/admin/submissions/${submission.id}`;
    }

    return card;
  };

  const renderList = (
    selector: string,
    submissions: Submission[],
    reviewed: boolean,
  ) => {
    const list = document.querySelector<HTMLElement>(
      `[data-list="${selector}"]`,
    );
    const count = document.querySelector<HTMLElement>(
      `[data-count="${selector}"]`,
    );
    if (!list) return;

    list.replaceChildren();
    if (count) count.textContent = String(submissions.length);

    if (submissions.length === 0) {
      const emptyMessage = document.createElement("p");
      emptyMessage.className = "submission-empty";
      emptyMessage.textContent = reviewed
        ? "No Reviewed Submissions"
        : "No Unreviewed Submissions";
      list.append(emptyMessage);
      return;
    }

    submissions.forEach((submission) => {
      const card = createCard(submission, reviewed);
      if (card) list.append(card);
    });
  };

  const loadSubmissions = async () => {
    try {
      const response = await fetch("/api/getSubmissions");
      if (!response.ok) throw new Error("Unable to load submissions");

      const data = (await response.json()) as { submissions?: Submission[] };
      const submissions = data.submissions ?? [];
      renderList(
        "unreviewed",
        submissions.filter(
          (submission) => submission.submissionStatus === "pending",
        ),
        false,
      );
      renderList(
        "reviewed",
        submissions.filter(
          (submission) => submission.submissionStatus !== "pending",
        ),
        true,
      );
    } catch {
      if (errorMessage) errorMessage.hidden = false;
      document.querySelectorAll<HTMLElement>("[data-list]").forEach((list) => {
        list.replaceChildren();
      });
    }
  };

  loadSubmissions();
</script>
