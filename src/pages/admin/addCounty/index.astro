---
import AdminNavBar from "../../../components/adminnavbar.astro";
import Layout from "../../../layouts/layout.astro";
import styles from "./addCounty.module.css";
---

<Layout>
  <AdminNavBar />
  <div class={styles.container}>
    <section class={styles.countiesPanel} aria-labelledby="counties-heading">
      <h1 id="counties-heading">Counties</h1>
      <div
        class={styles.countyList}
        id="county-list"
        aria-live="polite"
        aria-busy="true"
      >
        <p class={styles.listMessage}>Loading counties...</p>
      </div>
    </section>
    <div class={styles.formPanel}>
      <form class={styles.formContainer} id="add-county-form">
        <h1>Add County</h1>
        <label for="county-name">County name:</label>
        <input type="text" id="county-name" name="name" required />
        <button type="submit">Add County</button>
        <p
          class={styles.message}
          id="add-county-message"
          role="alert"
          aria-live="polite"
        >
        </p>
      </form>
    </div>
  </div>
</Layout>

<script>
  const countyList = document.getElementById("county-list") as HTMLDivElement;
  const form = document.getElementById("add-county-form") as HTMLFormElement;
  const message = document.getElementById(
    "add-county-message",
  ) as HTMLParagraphElement;
  const countyName = document.getElementById("county-name") as HTMLInputElement;

  const renderCounties = (
    counties: Array<{ name: string; schoolCount: number }>,
  ) => {
    countyList.replaceChildren();

    if (counties.length === 0) {
      const emptyMessage = document.createElement("p");
      emptyMessage.className = "listMessage";
      emptyMessage.textContent = "No counties have been added yet.";
      countyList.append(emptyMessage);
      return;
    }

    counties.forEach((county) => {
      const countyItem = document.createElement("div");
      countyItem.className = "countyItem";
      countyItem.textContent = `${county.name} (${county.schoolCount} ${county.schoolCount === 1 ? "School" : "Schools"})`;
      countyList.append(countyItem);
    });
  };

  const fetchCounties = async () => {
    countyList.setAttribute("aria-busy", "true");

    try {
      const response = await fetch("/api/getCounties");
      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || "Unable to load counties.");
      }

      renderCounties(result.cleanedCounties);
    } catch {
      countyList.replaceChildren();
      const errorMessage = document.createElement("p");
      errorMessage.className = "listMessage";
      errorMessage.textContent = "Unable to load counties. Please try again.";
      countyList.append(errorMessage);
    } finally {
      countyList.setAttribute("aria-busy", "false");
    }
  };

  form?.addEventListener("submit", async (event: SubmitEvent) => {
    event.preventDefault();
    message.textContent = "";

    try {
      const response = await fetch("/api/addCounty", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ name: countyName.value }),
      });
      const result = await response.json();

      if (!response.ok) {
        message.textContent =
          result.message || "Unable to add county. Please try again.";
        return;
      }

      countyName.value = "";
      await fetchCounties();
    } catch {
      message.textContent = "Unable to add county right now. Please try again.";
    }
  });

  fetchCounties();
</script>
