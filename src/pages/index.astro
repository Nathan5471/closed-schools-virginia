  </div>
</Layout>

<style>
  .des {
    background-color: #404E38;
    color: #E6E6E6;
  }
  .words {
    margin-left: 2rem;
  }
  .comb-list {
    display: flex;
    flex-direction: horizontal;
  }
</style>