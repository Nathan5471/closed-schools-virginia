---
import Layout from "../layouts/layout.astro";
import NavBar from "../components/navbar.astro";
import styles from "./index.module.css";
import CountiesList from "../components/countiesList.astro";
---

<Layout>
  <div>
    <NavBar />
    <div class={styles.des}>
      <h3 class={styles.words}>
        The Former Schools of Virginia website contains information about
        schools that have been closed here in Virginia. Each page will contain
        information about the school, the address (if available), images (if
        available), and the sources the information came from. If you have any
        extra information about a school, please use the form in the NavBar to
        report it.
      </h3>
    </div>
    <div>
      <CountiesList width="40%" />
    </div>
  </div>
</Layout>
