---
import styles from "./countieslist.module.css"

interface Props {
  width?: string;
  allowDelete?: boolean;
  refreshEvent?: string;
}

const {
  width = "100%",
  allowDelete = false,
  refreshEvent = "refresh-counties",
} = Astro.props;
---

<section
  class={styles.countiesList}
  style={`--counties-list-width: ${width}`}
  data-refresh-event={refreshEvent}
  data-allow-delete={allowDelete}
  aria-labelledby="counties-list-heading"
>
  <div class={styles.countiesListHeader}>
    <h2 id="counties-list-heading">Counties</h2>
    <div class={styles.countiesListContent} aria-live="polite" aria-busy="true">
      <p class={styles.countiesListMessage}>Loading counties...</p>
    </div>
  </div>
</section>

<script>
  type County = { id: number; name: string; schoolCount: number };
 
  const lists = document.querySelectorAll<HTMLElement>(".countiesList");
  console.log(lists)
  lists.forEach((list) => {
    const content = list.querySelector<HTMLElement>(".countiesListContent");
    const refreshEvent = list.dataset.refreshEvent;
    const allowDelete = list.dataset.allowDelete === "true";
    console.log("content:" + content + " refresh event:" + refreshEvent + " allow delete:" + allowDelete)
    if (!content) return;

    const renderCounties = (counties: County[]) => {
      content.replaceChildren();

      if (counties.length === 0) {
        const emptyMessage = document.createElement("p");
        emptyMessage.className = "countiesListMessage";
        emptyMessage.textContent = "0 counties found";
        content.append(emptyMessage);
        return;
      }

      counties.forEach((county) => {
        const countyItem = document.createElement("div");
        countyItem.className = "countiesListItem";

        const countyLabel = document.createElement("span");
        countyLabel.textContent = `${county.name} (${county.schoolCount} ${county.schoolCount === 1 ? "School" : "Schools"})`;

        countyItem.append(countyLabel);

        if (allowDelete) {
          const deleteButton = document.createElement("button");
          deleteButton.className = "deleteCountyButton";
          deleteButton.type = "button";
          deleteButton.setAttribute(
            "aria-label",
            `Delete ${county.name} County`,
          );
          deleteButton.title = `Delete ${county.name} County`;
          deleteButton.textContent = "×";
          deleteButton.addEventListener("click", async () => {
            deleteButton.disabled = true;

            try {
              const response = await fetch(
                `/api/deleteCounty?id=${county.id}`,
                {
                  method: "DELETE",
                },
              );

              if (!response.ok) throw new Error("Unable to delete county.");
              await fetchCounties();
            } catch {
              deleteButton.disabled = false;
            }
          });

          countyItem.append(deleteButton);
        }

        content.append(countyItem);
      });
    };

    const fetchCounties = async () => {
      content.setAttribute("aria-busy", "true");

      try {
        const response = await fetch("/api/getCounties");
        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || "Unable to load counties.");
        }

        renderCounties(result.cleanedCounties);
      } catch {
        content.replaceChildren();
        const errorMessage = document.createElement("p");
        errorMessage.className = "countiesListMessage";
        errorMessage.textContent = "Unable to load counties. Please try again.";
        content.append(errorMessage);
      } finally {
        content.setAttribute("aria-busy", "false");
      }
    };

    if (refreshEvent) {
      document.addEventListener(refreshEvent, fetchCounties);
    }

    console.log("FETCHING THE COUNTIES")
    fetchCounties();
  });
</script>
