---
import styles from "./countieslist.module.css";

interface Props {
  width?: string;
  allowDelete?: boolean;
  refreshEvent?: string;
}

const {
  width = "100%",
  allowDelete = false,
  refreshEvent = "refresh-counties",
} = Astro.props;
---

<section
  class={styles.countiesList}
  style={`width: ${width}`}
  data-refresh-event={refreshEvent}
  data-allow-delete={allowDelete}
  data-counties-list-class={styles.countiesList}
  data-counties-list-content-class={styles.countiesListContent}
  data-counties-list-item-class={styles.countiesListItem}
  data-counties-list-message-class={styles.countiesListMessage}
  data-county-link-class={styles.countyLink}
  data-delete-county-button-class={styles.deleteCountyButton}
  aria-labelledby="counties-list-heading"
>
  <div class={styles.countiesListHeader}>
    <h2 id="counties-list-heading">Counties</h2>
    <div class={styles.countyControls}>
      <label>
        Search counties
        <input type="search" data-county-search placeholder="Search counties" />
      </label>
      <label>
        Sort by
        <select data-county-sort>
          <option value="name">County name</option>
          <option value="schools">School count</option>
        </select>
      </label>
      <label>
        Order
        <select data-county-order>
          <option value="asc">Ascending</option>
          <option value="desc">Descending</option>
        </select>
      </label>
    </div>
  </div>
  <div class={styles.countiesListContent} aria-live="polite" aria-busy="true">
    <p class={styles.countiesListMessage}>Loading counties...</p>
  </div>
</section>

<script>
  type County = { id: number; name: string; schoolCount: number };

  const lists = document.querySelectorAll<HTMLElement>(
    "[data-counties-list-class]",
  );
  lists.forEach((list) => {
    const contentClass = list.dataset.countiesListContentClass;
    const itemClass = list.dataset.countiesListItemClass;
    const messageClass = list.dataset.countiesListMessageClass;
    const countyLinkClass = list.dataset.countyLinkClass;
    const deleteButtonClass = list.dataset.deleteCountyButtonClass;
    const content = contentClass
      ? list.querySelector<HTMLElement>(`.${contentClass}`)
      : null;
    const refreshEvent = list.dataset.refreshEvent;
    const allowDelete = list.dataset.allowDelete === "true";
    const search = list.querySelector<HTMLInputElement>("[data-county-search]");
    const sortField =
      list.querySelector<HTMLSelectElement>("[data-county-sort]");
    const sortOrder = list.querySelector<HTMLSelectElement>(
      "[data-county-order]",
    );
    let allCounties: County[] = [];
    if (
      !content ||
      !itemClass ||
      !messageClass ||
      !deleteButtonClass ||
      !countyLinkClass
    )
      return;

    const renderCounties = () => {
      const query = search?.value.trim().toLowerCase() || "";
      const direction = sortOrder?.value === "desc" ? -1 : 1;
      const counties = allCounties
        .filter((county) => county.name.toLowerCase().includes(query))
        .sort((first, second) => {
          const firstValue =
            sortField?.value === "schools" ? first.schoolCount : first.name;
          const secondValue =
            sortField?.value === "schools" ? second.schoolCount : second.name;
          return typeof firstValue === "number"
            ? (firstValue - (secondValue as number)) * direction
            : firstValue.localeCompare(secondValue as string) * direction;
        });
      content.replaceChildren();

      if (counties.length === 0) {
        const emptyMessage = document.createElement("p");
        emptyMessage.className = messageClass;
        emptyMessage.textContent = "0 counties found";
        content.append(emptyMessage);
        return;
      }

      counties.forEach((county) => {
        const countyItem = document.createElement("div");
        countyItem.className = itemClass;

        const countyLabel = document.createElement("span");
        countyLabel.textContent = `${county.name} (${county.schoolCount} ${county.schoolCount === 1 ? "School" : "Schools"})`;

        const countyLink = document.createElement("a");
        countyLink.className = countyLinkClass;
        countyLink.href = allowDelete
          ? `/counties/${county.id}?from=admin`
          : `/counties/${county.id}`;
        countyLink.append(countyLabel);
        countyItem.append(countyLink);

        if (allowDelete) {
          const deleteButton = document.createElement("button");
          deleteButton.className = deleteButtonClass;
          deleteButton.type = "button";
          deleteButton.setAttribute(
            "aria-label",
            `Delete ${county.name} County`,
          );
          deleteButton.title = `Delete ${county.name} County`;
          deleteButton.textContent = "×";
          deleteButton.addEventListener("click", async () => {
            deleteButton.disabled = true;

            try {
              const response = await fetch(
                `/api/deleteCounty?id=${county.id}`,
                {
                  method: "DELETE",
                },
              );

              if (!response.ok) throw new Error("Unable to delete county.");
              await fetchCounties();
            } catch {
              deleteButton.disabled = false;
            }
          });

          countyItem.append(deleteButton);
        }

        content.append(countyItem);
      });
    };

    const fetchCounties = async () => {
      content.setAttribute("aria-busy", "true");

      try {
        const response = await fetch("/api/getCounties");
        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || "Unable to load counties.");
        }

        allCounties = result.cleanedCounties;
        renderCounties();
      } catch {
        content.replaceChildren();
        const errorMessage = document.createElement("p");
        errorMessage.className = messageClass;
        errorMessage.textContent = "Unable to load counties. Please try again.";
        content.append(errorMessage);
      } finally {
        content.setAttribute("aria-busy", "false");
      }
    };

    if (refreshEvent) {
      document.addEventListener(refreshEvent, fetchCounties);
    }

    search?.addEventListener("input", renderCounties);
    sortField?.addEventListener("change", renderCounties);
    sortOrder?.addEventListener("change", renderCounties);

    fetchCounties();
  });
</script>
