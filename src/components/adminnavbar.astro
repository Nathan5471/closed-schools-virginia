---
import styles from "./adminnavbar.module.css";
---

<div class={styles.container}>
  <a href="/admin"
    ><button class={`${styles.button} ${styles.home}`} id="ahome"
      >Former Schools of Virginia | ADMIN</button
    ></a
  >
  <a href="/admin/addCounty" class={styles.startNavButtons}
    ><button class={`${styles.button} ${styles.small}`} id="acounty"
      >+ County</button
    ></a
  >
  <a href="/admin/addSchool"
    ><button class={`${styles.button} ${styles.small}`} id="aschool"
      >+ School</button
    ></a
  >
  <a href="/admin/submissions"
    ><button class={`${styles.button} ${styles.small}`} id="asub"
      >Submissions</button
    ></a
  >
</div>
