---
import styles from "virtual:astro:image-styles.css";
import "./navbar.css"
---

<div class="container">
    <h1></h1>
    <a href="/admin"><button class="home" id="ahome">Former Schools of Virginia | ADMIN</button></a>
    <a href="/admin/plusc"><button class="small" id="acounty">+ County</button></a>
    <a href="/admin/pluss"><button class="small" id="aschool">+ School</button></a>
    <a href="/admin/subs"><button class="small" id="asub">Submissions</button></a>
</div>

<style>
    .container { background-color: transparent; height: 100; width: 100% }
    button { height: 50; background-color: transparent; border: transparent; border-radius: 25; transition: background-color 0.5s ease, transform 0.5s ease, box-shadow 0.5s ease }
    button:hover {
        cursor: pointer;
    }
    button.small:hover {
        background-color: #BAC8B1;
        transform: translateY(5px);
        box-shadow: 0px -5px 10px rgba(0, 0, 0, 0.2);
    }
    .home {
        width: 45%;
        margin-right: 15%;
    }
</style>


